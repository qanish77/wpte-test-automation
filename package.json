{
  "name": "wpte-automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test":              "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test --project='Desktop Chrome' && PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" node update-skill.js",
    "test:all-browsers": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test && PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" node update-skill.js",
    "test:headed":       "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test --headed --project='Desktop Chrome'",
    "test:ui":           "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test --ui --trace=on",

    "test:chrome":       "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test --project='Desktop Chrome'",
    "test:safari":       "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test --project='Desktop Safari'",
    "test:mobile":       "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:mobile-chrome":"PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test --project='Mobile Chrome'",
    "test:mobile-safari":"PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test --project='Mobile Safari'",
    "test:ipad":         "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test --project='iPad'",

    "test:auth":         "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test tests/auth/ --project='Desktop Chrome'",
    "test:trips":        "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test tests/trips/ --project='Desktop Chrome'",
    "test:booking":      "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test tests/booking/ --project='Desktop Chrome'",
    "test:account":      "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test tests/account/ --project='Desktop Chrome'",
    "test:addons":       "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test tests/addons/ --project='Desktop Chrome'",

    "test:addons:fsd":              "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test tests/addons/fsd.spec.js --project='Desktop Chrome'",
    "test:addons:group-discount":   "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test tests/addons/group-discount.spec.js --project='Desktop Chrome'",
    "test:addons:extra-services":   "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test tests/addons/extra-services.spec.js --project='Desktop Chrome'",
    "test:addons:partial-payment":  "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test tests/addons/partial-payment.spec.js --project='Desktop Chrome'",
    "test:addons:travel-insurance": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test tests/addons/travel-insurance.spec.js --project='Desktop Chrome'",
    "test:addons:pickup":           "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test tests/addons/pickup-point.spec.js --project='Desktop Chrome'",
    "test:addons:accommodation":    "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test tests/addons/accommodation.spec.js --project='Desktop Chrome'",

    "test:admin":              "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test tests/admin/ --project='Desktop Chrome'",
    "test:admin:global":       "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test tests/admin/global-settings.spec.js --project='Desktop Chrome'",
    "test:admin:trip-settings":"PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test tests/admin/trip-settings.spec.js --project='Desktop Chrome'",

    "test:smoke":    "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test tests/auth/login.spec.js tests/trips/trip-detail.spec.js tests/booking/booking-flow.spec.js --project='Desktop Chrome' --reporter=list",
    "test:release":  "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test tests/auth/ tests/trips/ tests/booking/ tests/account/ tests/addons/ tests/admin/ --project='Desktop Chrome' --project='Desktop Safari' --reporter=list",
    "test:cross-browser": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test tests/booking/ tests/trips/ --project='Desktop Chrome' --project='Desktop Safari' --project='Mobile Safari' --project='Mobile Chrome' --reporter=list",

    "test:debug":    "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright test --debug --project='Desktop Chrome'",
    "report":        "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" npx playwright show-report",
    "update-skill":  "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" node update-skill.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^25.6.0",
